# 智谱 API 密钥(必填)——到 https://open.bigmodel.cn 控制台获取
# 注意:本文件是模板,会被提交到 git!真实密钥只写在 .env(已被 gitignore)
ZHIPUAI_API_KEY=你的API密钥

# 对话模型(可选):glm-4-flash 免费;glm-4-plus 更强
CHAT_MODEL=glm-4-flash

# 向量模型提供商(可选):zhipu=云端 embedding-3(收费,需余额);local=本地开源模型(免费,首次下载约100MB)
EMBEDDING_PROVIDER=local

# 向量模型(可选,zhipu 提供商时生效)
EMBEDDING_MODEL=embedding-3

# 本地向量模型(可选,local 提供商时生效)
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 切分与检索参数(可选)
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=4
